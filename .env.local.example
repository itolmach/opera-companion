# Copy to .env.local and fill in your own values.
#
# This MUST be the same Supabase project the OperaApp iOS app points at
# (its OperaApp/Config/Config.xcconfig) -- that's what makes "one account,
# one dataset" across web and iOS actually true. See SUPABASE_SETUP.md in
# the OperaApp repo for where these come from and how to run the shared
# migrations in supabase/migrations.
#
# Both are safe to expose to the browser (NEXT_PUBLIC_*): access is
# enforced by the Row Level Security policies in the migrations, not by
# keeping these values secret.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
