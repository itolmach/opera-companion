# Copy to .env.local and fill in your own values.
#
# Point this at the STAGING Supabase project, not the production one the iOS
# app ships against. Both projects run the same migrations (in the OperaApp
# repo, supabase/migrations) so the schema matches; only the data differs.
#
# Why staging: this app deploys to GitHub Pages, where every branch preview
# shares the itolmach.github.io origin. A session -- and any mistake -- reaches
# across all of them, so previews must not be able to touch production data.
# See README.md, "Two Supabase projects".
#
# Both values are safe to expose to the browser (NEXT_PUBLIC_*): access is
# enforced by the Row Level Security policies in the migrations, not by keeping
# these secret. There is no server in this build, so nothing here can be
# private -- never add a service-role key to this file.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-STAGING-ANON-KEY
